rules_version = '2';

/* ═══════════════════════════════════════════════════════════════
   원그로브 종합점검 현황판 — Cloud Storage 보안 규칙
   사진을 Firebase Storage 에 저장할 때만 필요합니다.
   (사진을 Google Drive 나 이 기기에 두면 설정하지 않아도 됩니다)
   Firebase 콘솔 → Storage → 규칙 에 붙여넣고 [게시]
   ═══════════════════════════════════════════════════════════════ */

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in [
               'withwe68@gmail.com'
             ];
    }

    /* 점검 사진 — photos/{회차}/{파일명} */
    match /photos/{half}/{fileName} {

      /* 조회는 누구나 */
      allow read: if true;

      /* 업로드: 이미지 파일 · 12MB 이하 · 로그인 상태 */
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      /* 삭제는 관리자만 */
      allow delete: if isAdmin();

      /* ── 더 엄격하게 운영할 때는 위 write 조건의
         request.auth != null 을 isAdmin() 으로 바꾸세요. ── */
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
